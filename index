<script>
(function(){
  var idx=0, total=3, timer;
  function showSlide(n){
    var slides=document.querySelectorAll('#trainingSlide .slide');
    var dots=document.querySelectorAll('#slideDots .dot');
    idx=(n+total)%total;
    slides.forEach(function(s,i){s.classList.toggle('active',i===idx);});
    dots.forEach(function(d,i){d.classList.toggle('active',i===idx);});
  }
  window.goToSlide=function(n){showSlide(n);resetTimer();};
  window.changeSlide=function(d){showSlide(idx+d);resetTimer();};
  function resetTimer(){clearInterval(timer);timer=setInterval(function(){showSlide(idx+1);},4000);}
  resetTimer();
})();
</script>




